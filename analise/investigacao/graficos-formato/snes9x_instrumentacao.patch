@@ -0,0 +1,17 @@
+#ifndef _DBG_H_
+#define _DBG_H_
+#include <stdio.h>
+#include <stdint.h>
+extern uint32_t dbg_op_pc;
+extern uint32_t dbg_frame;
+extern uint32_t dbg_wram_writer[0x20000];
+extern uint32_t dbg_rom_reader[0x400000];
+extern uint8_t  dbg_exec[0x200000];
+extern FILE *dbg_log;
+extern uint8_t dbg_bpmap[0x200000];
+void dbg_on_bp(void);
+extern FILE *dbg_bin;
+void dbg_on_dma(int ch);
+void dbg_on_vram_cpu(int hi, uint8_t byte);
+void dbg_on_cg_cpu(uint8_t byte);

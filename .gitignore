# ROM comercial: não versionar
*.sfc
*.smc
# build / deps
node_modules/
web/dist/
.DS_Store
*.log

# análise: binários locais e estados do emulador (contêm dados da ROM)
analise/ferramentas/*.dylib
analise/estados/
analise/extraido/

# screenshots do npm run snap (web/scripts/snapshots.mjs): imagens da ROM, não versionar
web/snapshots/

# ROM servida só durante o rastreio do pacote (web/scripts/rom-pack/play.mjs)
web/.rom/
web/dist-e2e/
